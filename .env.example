# ==========================================
# KCquant Environment Configuration
# ==========================================

# 1. Databento Market Data API (Optional - for settlement sync)
DATABENTO_API_KEY=your_databento_api_key_here

# 2. Telegram Bot Configuration (Required for cloud notifications)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# 3. CQG Desktop Credentials (https://m.cqg.com/cqg/desktop/main)
# When provided, the bot prioritizes real-time quotes directly from CQG Desktop.
CQG_USERNAME=your_cqg_username_here
CQG_PASSWORD=your_cqg_password_here

# Optional: Broker / Partner code (e.g. 'cqg', 'amp', 'ironbeam'). Default: 'cqg'
CQG_BROKER=cqg

# Optional: Custom desktop URL if your broker provides a dedicated branded portal.
# Default: 'https://m.cqg.com/cqg/desktop/main'
CQG_URL=https://m.cqg.com/cqg/desktop/main

# Optional: Browser page load timeout in seconds (Default: 15)
CQG_TIMEOUT=15
