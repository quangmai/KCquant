# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Environment and sensitive keys
.env
.env.*
!.env.example

# OS files
.DS_Store

# Heavy raw binary data and cache
data/raw/
*.dbn.zst

# Runtime monitor logs and temporary outputs
output/monitor/*.log
output/monitor/*.png
output/*.parquet

# Track persistent monitor history & order logs
!output/monitor/kc_cqg_intraday_5m.csv
!output/monitor/kc_market_history.csv
!output/monitor/kc_telegram_log.jsonl
!output/monitor/zh_spread_history.csv
!output/orders/*


# IDE / Editor files
.vscode/
.idea/
